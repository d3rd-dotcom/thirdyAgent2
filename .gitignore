# ═══════════════════════════════════════════════════════════
#  thirdyAgent2 — .gitignore
#  GitHub migration ready — protects secrets and runtime data
# ═══════════════════════════════════════════════════════════

# ── Secrets (NEVER commit) ──────────────────────────────────
.env
.env.local
.env.production

# ── Runtime / auto-generated data ───────────────────────────
agent_memory.json
agent_knowledge.json
skill_log.txt
replied_ids.txt
greeted_agents.txt
broadcast_log.txt
watchdog_log.txt
evolution_log.txt
engine_state.json
watchdog_state.json
reload.flag

# ── Auto-generated skill file (managed by skill_engine.py) ──
skills_free_evolved.py

# ── Logs ────────────────────────────────────────────────────
*.log
agent_output.log
chatbot_output.log
skill_engine_output.log

# ── Vector database (rebuild with: python build_rag.py) ─────
chroma_db/
qdrant_storage/
embed_cache/

# ── Python cache ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ─────────────────────────────────────
venv/
env/
.venv/
*.egg-info/
dist/
build/

# ── Windows / OS junk ────────────────────────────────────────
desktop.ini
Thumbs.db
.DS_Store

# ── Temp / misc ──────────────────────────────────────────────
*.tmp
*.bak
cd
python
