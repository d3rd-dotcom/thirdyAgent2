# ═══════════════════════════════════════════════════════════════════
#  thirdyAgent2 — .env.example
#  Copy to .env and fill in your real keys.
#  .env is in .gitignore — NEVER commit it.
# ═══════════════════════════════════════════════════════════════════

# ── PIN AI AgentHub ────────────────────────────────────────────────
# Register at: https://agents.pinai.tech
AGENTHUB_API_KEY=pk_live_YOUR_KEY_HERE
AGENT_ID=thirdyAgent2-YOUR_AGENT_SUFFIX
AGENTHUB_HUB_URL=https://agents.pinai.tech
PUBLIC_URL=https://YOUR_NGROK_URL.ngrok-free.app

# ── AI Providers (all have free tiers) ────────────────────────────
# Groq      → https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_GROQ_KEY

# Cerebras  → https://cloud.cerebras.ai/
CEREBRAS_KEY=csk-YOUR_CEREBRAS_KEY

# NVIDIA NIM → https://build.nvidia.com/
NVIDIA_KEY=nvapi-YOUR_NVIDIA_KEY

# Cloudflare Workers AI → https://dash.cloudflare.com/
CF_KEY=cfut_YOUR_CF_KEY
CF_ACCOUNT=YOUR_CF_ACCOUNT_ID

# Mistral   → https://console.mistral.ai/
MISTRAL_KEY=YOUR_MISTRAL_KEY

# Cohere    → https://dashboard.cohere.com/
COHERE_KEY=YOUR_COHERE_KEY

# Gemini    → https://aistudio.google.com/app/apikey
GEMINI_KEY=YOUR_GEMINI_KEY

# GitHub Models → https://github.com/marketplace/models (PAT with models scope)
GITHUB_MODELS_KEY=ghp_YOUR_GITHUB_MODELS_PAT

# ── RAG (ChromaDB) ────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
RAG_TOP_K=4
RAG_EMBED_MODEL=embed-english-v3.0
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# ── App ───────────────────────────────────────────────────────────
FLASK_PORT=5000
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
